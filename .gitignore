# Unity .gitignore
# Ignore Library, Temp, Logs, UserSettings, cache, and IDE solution files

/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Never ignore asset meta files
!/[Aa]ssets/**/*.meta

# Visual Studio / VSCode cache
.vs/
.vscode/

# Gradle / Android cache
.gradle/

# Auto-generated solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports & OS files
sysinfo.txt
.DS_Store
Thumbs.db
